// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.thermal-service.alioth",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.alioth.rc"],
    vintf_fragments: ["android.hardware.thermal-service.alioth.xml"],
    srcs: ["main.cpp", "Thermal.cpp", "Observer.cpp"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cppflags: ["-fexceptions"],
    stl: "c++_static",
    static_libs: ["android.hardware.thermal-V1-ndk"],
    shared_libs: ["libbinder_ndk", "liblog"],
}
