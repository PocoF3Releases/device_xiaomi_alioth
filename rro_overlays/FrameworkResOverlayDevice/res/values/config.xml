<!-- POCO F3 (alioth) framework resource overrides for Android 17.
     Keep these values device-specific and non-translatable.

     DisplayDeviceConfig (/vendor/etc/displayconfig/display_id_4630946736638489729.xml)
     owns the physical backlight-to-nits mapping, HBM policy, ambient-light horizons,
     and Android 17-native ambient hysteresis. This RRO provides the stock alioth
     ambient-lux-to-nits curve plus framework feature/fallback resources. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Display power / AOD -->

    <!-- Enables framework-managed adaptive brightness for the built-in display.
         Android uses the configured ambient light sensor and the device-specific lux-to-nits
         curve below when adaptive brightness is enabled. -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Use discrete brightness buckets while the display is in doze/AOD states.
         This affects doze brightness handling only; it does not define the normal interactive
         brightness curve or HBM behavior. -->
    <bool name="config_displayBrightnessBucketsInDoze">true</bool>

    <!-- Advertises Always-On Display support for this device. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>

    <!-- Default state of Always-On Display when the user has not chosen a value yet. -->
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- Allow display power state to transition independently of the device interactive state.
         Used by doze/AOD power handling. -->
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- Default IWLAN data-service implementation used by the telephony framework. -->
    <string name="config_wlan_data_service_package" translatable="false">vendor.qti.iwlan</string>

    <!-- Refresh-rate policy -->

    <!-- Leave the default refresh-rate request unspecified.
         Alioth exposes 60 Hz and 120 Hz; display policy/HWC plus user/app constraints choose the
         effective mode. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <!-- Adaptive brightness -->

    <!-- Stock alioth MIUI ambient-lux-to-display-nits curve.
         The curve remains in the framework RRO because Android's brightness mapper consumes
         config_autoBrightnessLevels together with config_autoBrightnessDisplayValuesNits.
         Ambient hysteresis, ALS filtering horizons, physical panel calibration and HBM policy
         are supplied by DisplayDeviceConfig. -->

<!-- Desired display luminance, in nits, for config_autoBrightnessLevels.
         This is the stock alioth MIUI physical auto-brightness curve adapted for Android 17.

         The 108 luminance entries pair with 107 explicit lux breakpoints; the first nits value
         is the implicit 0-lux point. The curve crosses the normal/HBM boundary around
         5500-6000 lux (496.3 -> 513 nits), matching the 6001-lux HBM gate in DisplayDeviceConfig.

         Requested values above the panel's physical maximum are intentional. DisplayDeviceConfig
         maps/clamps them to the supported panel range (up to 900 physical nits).

         Keep this as <array>, not <integer-array>, because the stock curve contains fractional
         nit values. Values must stay non-negative and non-decreasing. -->
