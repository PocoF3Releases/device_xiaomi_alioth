    <!-- Brightness hysteresis / adjustment -->

    <!-- Screen-brightness hysteresis after the ambient-light decision.
         Zero means no additional screen-brightness hysteresis is applied to increases. -->
    <integer-array name="config_screenBrighteningThresholds">
        <item>0</item>
    </integer-array>

    <!-- Screen-brightness hysteresis after the ambient-light decision.
         Zero means no additional screen-brightness hysteresis is applied to decreases. -->
    <integer-array name="config_screenDarkeningThresholds">
        <item>0</item>
    </integer-array>

    <!-- Maximum gamma for the framework adaptive-brightness adjustment model.
         100% corresponds to maxGamma = 1.0, matching the alioth stock behavior. User/short-term
         learning can still alter the effective curve independently. -->
    <fraction name="config_autoBrightnessAdjustmentMaxGamma">100%</fraction>

    <!-- Ambient-light transition debounce, in milliseconds.
         Xiaomi uses 1000 ms for both brightening and darkening. Android 17 applies these after
         the DisplayDeviceConfig ambient-hysteresis thresholds and ALS horizon filtering. -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">1000</integer>

    <!-- Legacy integer brightness settings -->

    <!-- Legacy 0-255 maximum brightness setting.
         This does not define the physical panel/HBM ceiling; Android 17 obtains that from
         DisplayDeviceConfig. -->
    <integer name="config_screenBrightnessSettingMaximum">255</integer>

    <!-- Legacy 0-255 minimum brightness setting.
         The effective physical minimum is resolved through the Android 17 display mapping. -->
    <integer name="config_screenBrightnessSettingMinimum">2</integer>

    <!-- Legacy 0-255 dim brightness fallback.
         Android 17 uses the active float dim configuration at runtime; this does not define the
         adaptive-brightness curve. -->
    <integer name="config_screenBrightnessDim">6</integer>

    <!-- Display cutout / OLED protection -->

    <!-- Native-pixel path for alioth's centered front-camera display cutout.
         Coordinates are relative to the top-center origin of the built-in 1080x2400 panel. -->
    <string translatable="false" name="config_mainBuiltInDisplayCutout">
        M -23,52
        M 23,52
        A 23,23 0 1,0 -23,52
        A 23,23 0 1,0 23,52
        Z
    </string>

    <!-- Rectangular approximation of the main display cutout used by APIs that expose one
         bounding rectangle per display edge. Keep aligned with config_mainBuiltInDisplayCutout. -->
    <string translatable="false" name="config_mainBuiltInDisplayCutoutRectApproximation">
        M 0,0
        H -23
        V 75
        H 23
        V 0
        H 0
        Z
    </string>

    <!-- Fill the physical cutout region in software to avoid visible aliasing/artifacts. -->
    <bool name="config_fillMainBuiltInDisplayCutout">true</bool>

    <!-- Enable periodic display-content shifting in ambient/AOD mode to reduce OLED burn-in. -->
    <bool name="config_enableBurnInProtection">true</bool>
